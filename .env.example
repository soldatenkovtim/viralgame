# Server-only. Set in Vercel project settings; never prefix with VITE_.
# Connect a Neon database via Vercel Storage to populate DATABASE_URL automatically.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Without DATABASE_URL, local dev and Coolify use SQLite. Vercel requires Postgres.
# DUEL_DB_PATH=.data/duels.sqlite
